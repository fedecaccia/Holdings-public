# Database (Vercel sets these when you connect a Neon store with the prefix HOLDINGS)
HOLDINGS_DATABASE_URL=
HOLDINGS_DB_NAME=holdings

# Login
ALLOWED_EMAIL=you@example.com
AUTH_PASSWORD_HASH=          # pnpm hash-password 'your-password'
SESSION_SECRET=              # openssl rand -hex 32
GOOGLE_CLIENT_ID=            # optional, Google login
GOOGLE_CLIENT_SECRET=

# API and cron
AGENT_API_TOKEN=             # openssl rand -hex 32
CRON_SECRET=                 # set by Vercel Cron
APP_URL=https://your-app.vercel.app

# Sources (all optional: leave empty what you don't use)
IOL_USERNAME=
IOL_PASSWORD=
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_TRADES_QUERY_ID=
ZERION_API_KEY=
ALCHEMY_API_KEY=
COINGECKO_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
